# Copy to .env for Docker Compose. Generate the secret with: openssl rand -hex 32
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""
AUTH_ALLOWED_EMAILS=""

# Passwordless email OTP delivery (use a sender on your verified Resend domain)
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Envelove <auth@example.com>"

# Local development only (ignored by Compose)
DATABASE_URL="./local.db"
SEED_EMAIL=""
